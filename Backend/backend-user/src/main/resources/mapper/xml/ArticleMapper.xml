<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.xiyanchenghong.backenduser.mapper.ArticleMapper">

    <resultMap id="ArticleResultMap" type="com.xiyanchenghong.backenduser.domain.Article">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="status" column="status"/>
        <result property="commentCount" column="comment_count"/>
        <result property="likeCount" column="like_count"/>
        <result property="readCount" column="read_count"/>
        <result property="channelId" column="channel_id"/>
        <result property="pubDate" column="pub_date"/>
        <result property="content" column="content"/>
        <association property="cover" column="{type=image,type=image}" select="selectCoverByArticleId" />
    </resultMap>

    <select id="getArticleById" resultMap="ArticleResultMap">
        SELECT * FROM article WHERE id = #{id}
    </select>

    <select id="getAllArticles" resultMap="ArticleResultMap">
        SELECT * FROM article
    </select>

    <insert id="insertArticle" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO article(title, content, status, channel_id, pub_date, cover)
        VALUES(#{title}, #{content}, #{status}, #{channelId}, #{pubDate}, #{cover})
    </insert>

    <update id="updateArticle">
        UPDATE article
        SET title=#{title}, content=#{content}, status=#{status}, channel_id=#{channelId}, pub_date=#{pubDate}, cover=#{cover}
        WHERE id=#{id}
    </update>

    <delete id="deleteArticle">
        DELETE FROM article WHERE id=#{id}
    </delete>

    <select id="getArticles" resultMap="ArticleResultMap">
        SELECT * FROM article
            ${spec}
            LIMIT #{offset}, #{perPage}
    </select>

    <select id="countArticles" resultType="long">
        SELECT COUNT(*) FROM article
                                 ${spec}
    </select>

    <select id="selectCoverByArticleId" resultType="com.xiyanchenghong.backenduser.domain.Cover">
        SELECT type, image FROM cover WHERE article_id = #{articleId}
    </select>
</mapper>